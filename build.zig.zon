.{
    .name = .zig_metal_unikernel,
    .version = "0.0.0",
    .fingerprint = 0x359118429fe2aac7,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // Coverage properties (COVERAGE.md): a sibling checkout, as
        // angry-gopher and metal-vmm are.
        .zig_coverage_sdk = .{ .path = "../zig-coverage-sdk" },
        // The Roc chat that angry-gopher's kernel serves: roc-webbox's
        // `roc_chat_metal`, a sibling checkout. Lazy: only `zig build
        // gopher` (and what builds it) reaches it.
        .roc_webbox = .{ .path = "../roc-webbox", .lazy = true },
    },
    .paths = .{""},
}
